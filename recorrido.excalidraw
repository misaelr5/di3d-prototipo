2, "versionNonce": 2012082737, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false, "text": "Abre la pregunta desde el celular y responde «6 mm».\nLa respuesta queda guardada en el pedido original.", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Abre la pregunta desde el celular y responde «6 mm».\nLa respuesta queda guardada en el pedido original.", "autoResize": true, "lineHeight": 1.15}, {"id": "9339eac6450b48c8a5381a5e71279bed", "type": "rectangle", "x": 36, "y": 780, "width": 748, "height": 1, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#c9cbc2", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 269393009, "version": 2, "versionNonce": 39502111, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false}, {"id": "249a3c22d6f244e59ad300ddab870d75", "type": "rectangle", "x": 36, "y": 799, "width": 5, "height": 24, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#373e39", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 269393009, "version": 2, "versionNonce": 39502111, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false}, {"id": "b05c3993f6b04bb3bf9a6ffc340b5479", "type": "text", "x": 52, "y": 802, "width": 97.0, "height": 17.25, "angle": 0, "strokeColor": "#525953", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1100030783, "version": 2, "versionNonce": 2012082737, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false, "text": "EQUIPO DI3D", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "EQUIPO DI3D", "autoResize": true, "lineHeight": 1.15}, {"id": "b4969532d92d4714959011a92e31a092", "type": "text", "x": 210, "y": 795, "width": 215.0, "height": 31.049999999999997, "angle": 0, "strokeColor": "#232627", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1100030783, "version": 2, "versionNonce": 2012082737, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false, "text": "Retoma el trabajo", "fontSize": 27, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Retoma el trabajo", "autoResize": true, "lineHeight": 1.15}, {"id": "af0d8e2a4caa430185a15da08c209d63", "type": "text", "x": 210, "y": 838, "width": 449.0, "height": 43.699999999999996, "angle": 0, "strokeColor": "#3c423e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1100030783, "version": 2, "versionNonce": 2012082737, "isDeleted": false, "boundElements": null, "updated": 1795484653414, "link": null, "locked": false, "text": "Encuentra la medida junto al croquis. Puede asignar\nun responsable y fijar la próxima revisión.", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Encuentra la medida junto al croquis. Puede asignar\nun responsable y fijar la próxima revisión.", "autoResize": true, "lineHeight": 1.15}, {"id": "66e521b3dad14b9bb29dc0b2fa8621ba", "type": "rectangle", "x": 36, "y": 925, "width": 748, "height": 1, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#c9cbc2", "fillStyle": "solid", "strokeWidth": 1.5, "strok